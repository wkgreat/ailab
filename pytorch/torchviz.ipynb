   "source": [
    "x = torch.randn(2,3,4)\n",
    "y = torch.randn(2,3,4)\n",
    "x.requires_grad_(True)\n",
    "y.requires_grad_(True)\n",
    "z = x+y\n",
    "dot = make_dot(z, params={'z':z,'x':x,'y':y})\n",
    "dot"
