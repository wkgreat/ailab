CompileFlags:
  Add:
    - -std=c++17
    - -I/home/wk/miniconda3/envs/ai/include/python3.11
    - -I/home/wk/miniconda3/envs/ai/lib/python3.11/site-packages/numpy/_core/include
    - -I/usr/local/cuda/include
---
If:
  PathMatch: .*\.(cu|cuh)
CompileFlags:
  Add:
    - -xcuda
    - --cuda-path=/usr/local/cuda
    # IntelliSense only: the host GPU is sm_120 (RTX 5060 Ti), which ptxas
    # handles via env.json / nvcc. clangd reads this purely for arch-dependent
    # builtins.
    - --cuda-gpu-arch=sm_120
Diagnostics:
  Suppress:
    - member_function_call_bad_type
    - typename_nested_not_found
    - err_typename_nested_not_found
    - ovl_no_viable_member_function_in_call
    - err_ovl_no_viable_member_function_in_call